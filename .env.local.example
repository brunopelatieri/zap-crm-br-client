# ============================================================
# OBRIGATÓRIAS — o app não inicia sem estas.
# ============================================================

# Supabase (Project Settings → API)
#
# NEXT_PUBLIC_SUPABASE_URL: URL do projeto (https://<ref>.supabase.co, sem
# barra no final). Vai para o navegador — não é segredo.
# NEXT_PUBLIC_SUPABASE_ANON_KEY: chave pública "anon". Também vai para o
# navegador; a proteção dos dados vem das políticas RLS, não desta chave.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chave service-role do Supabase. Ignora o RLS; usada somente pelas
# rotas server-side (o webhook, o motor de automações e o caminho de
# autenticação da API pública — veja docs/public-api.md). Mantenha
# esta chave em segredo — nunca a cole em código client-side.
#
# Nota: a API pública (/api/v1) não precisa de nenhuma variável de
# ambiente nova. As chaves de API são criadas no painel (Settings →
# API keys) e armazenadas com hash no banco de dados; esta chave
# service-role é o que permite ao caminho de autenticação buscar uma
# chave apresentada sem uma sessão de usuário.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Criptografia do token do WhatsApp (64 caracteres hex = 32 bytes,
# AES-256-GCM). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotacionar este valor torna órfão todo token criptografado com a
# chave anterior — os usuários precisam salvar novamente as
# configurações do WhatsApp para reconectar. É também a mesma chave
# que criptografa a chave de IA (OpenAI/Anthropic) que cada conta cola
# em Settings → AI Assistant — rotacionar quebra as duas coisas juntas.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifica a assinatura HMAC-SHA256 em cada POST de webhook recebido.
# Obrigatória — sem ela o webhook rejeita todas as requisições.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMENDADAS — existem padrões seguros, mas você vai querer
# configurá-las.
# ============================================================

# URL pública canônica deste deployment (esquema + host, sem barra
# no final). Usada para o sitemap e imagens OG. Rotas que precisam de
# uma URL auto-referencial (links de convite de
# /api/account/invitations, o link "abrir conta no console" dentro
# dos e-mails de notificação do sistema) derivam a origem a partir da
# própria requisição, então esta variável só é necessária quando a
# origem derivada da requisição estaria errada — por exemplo, ao
# gerar links a partir de um cron job ou de um worker em background
# que não tem uma requisição de entrada.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Atenção: esta variável NÃO controla o link de confirmação de e-mail
# / redefinição de senha do Supabase Auth. Esse redirect padrão vem da
# "Site URL" configurada no painel do Supabase (Authentication → URL
# Configuration), que precisa ser trocada manualmente de
# http://localhost:3000 para a URL de produção antes do primeiro
# deploy — veja "Configure a Site URL do Supabase antes de ir ao ar"
# no README.md.

# Idioma padrão do servidor para visitantes que ainda não escolheram
# um idioma (primeira visita, ou navegador bloqueando cookies).
# Depois da primeira escolha, o idioma passa a ser lido do cookie
# NEXT_LOCALE (definido em Configurações → Aparência) — esta variável
# não fixa mais o idioma de toda a instância.
# Valores aceitos: pt-BR (padrão do projeto), en.
NEXT_PUBLIC_APP_LOCALE=pt-BR

# ============================================================
# OPCIONAIS — necessárias apenas se você usar o recurso.
# ============================================================

# ------------------------------------------------------------------
# Cadastro público (self-service) — /signup sem convite (opcional)
# ------------------------------------------------------------------
# Liga/desliga a tela de "criar conta" para quem chega em /signup SEM
# um token de convite (ex.: alguém que descobriu a URL, ou clicou em
# "Criar conta" na tela de login).
#
# NÃO afeta o cadastro via convite: quem chega em
# /signup?invite=<token> a partir de /join/<token> (aceitando um
# convite de equipe já emitido por um admin) sempre consegue criar a
# conta, mesmo com esta variável desligando o cadastro público — ver
# src/lib/auth/signup-flag.ts. É o padrão comum de SaaS
# "somente por convite": fechar a porta de entrada pública sem quebrar
# convites que já foram enviados.
#
# Padrão (variável ausente) = cadastro público LIBERADO. Defina como
# "false" para desligar — qualquer outro valor (ou a ausência da
# variável) mantém o cadastro público ligado. Precisa do prefixo
# NEXT_PUBLIC_ porque a checagem roda no navegador (a tela /signup é
# um Client Component).
# NEXT_PUBLIC_SIGNUP_ENABLED=false

# ------------------------------------------------------------------
# Agendador cron — obrigatório se você usa disparo agendado,
# automações com passo de espera (Wait) ou gatilho "Baseado em
# horário", reengajamento de janela de 24h, retenção de mensagens ou
# vencimento/ciclo de plano.
# ------------------------------------------------------------------
# Segredo compartilhado que protege sete rotas de cron — um segredo
# só para o operador não ter que provisionar vários:
#
#   GET /api/automations/cron       — retoma automações em espera,
#     dispara o gatilho "Baseado em horário", o reengajamento de
#     janela 24h (fase 1-3) e — dentro do mesmo agendamento, sem rota
#     nova — a varredura de retenção de mensagens (fase 4, ver
#     MESSAGE_RETENTION_* abaixo), o vencimento/ciclo de plano (fase
#     5, SPEC 062) e a reentrega de notificações do sistema (fase 6,
#     SPEC 063, ver SMTP_*/SYSTEM_EVENT_WEBHOOK_* abaixo).
#   GET /api/flows/cron             — encerra execuções de fluxo
#     abandonadas.
#   GET /api/broadcasts/cron        — dispara as campanhas AGENDADAS
#     que venceram (SPEC 044 §6.3). Sem este pinger, um disparo
#     agendado fica em `scheduled` para sempre.
#   GET /api/messages/retention/cron — porta explícita opcional para
#     quem quer a limpeza de retenção num horário próprio (ex.: 03h),
#     em vez de esperar o ciclo embutido em /api/automations/cron.
#   GET /api/plans/lifecycle/cron   — porta explícita opcional para
#     quem quer o vencimento de plano num horário próprio, mesma
#     lógica da anterior.
#   GET /api/contacts/check/cron    — checagem de número na instância
#     QRCode (SPEC 069 R3/R6); também retoma campanhas em
#     `awaiting_check` que a fila esvaziou. A cada 5 min.
#   GET /api/contacts/harvest/cron  — captação de contatos da agenda
#     da instância QRCode (SPEC 069 R5); só age dentro da janela de
#     EVOLUTION_HARVEST_WINDOW_*/EVOLUTION_HARVEST_TIMEZONE abaixo.
#     De hora em hora, 00h–05h.
#
# Cada rota espera o segredo no cabeçalho `x-cron-secret`. Um ping a
# cada 5 minutos em /api/automations/cron, /api/flows/cron,
# /api/broadcasts/cron e /api/contacts/check/cron atende praticamente
# tudo (a granularidade do agendamento na interface é de minuto); as
# rotas "explícitas" e a de captação são só para quem quer cadência
# diferente. Exemplo com cron do sistema:
#
#   */5 * * * * curl -sS -H "x-cron-secret: $AUTOMATION_CRON_SECRET" \
#     https://crm.example.com/api/broadcasts/cron
#
# Sem esta variável no servidor, as sete rotas respondem `503` de
# propósito — falha alto, nunca em silêncio.
# Gere uma string longa e aleatória com:
#   openssl rand -hex 32
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Allow-list de defesa em profundidade para os hostnames que
# /api/account/invitations pode publicar em URLs de convite.
# Separados por vírgula, sem esquema, sem porta (apenas hostnames).
#
# Por que isso existe: quando NEXT_PUBLIC_SITE_URL não está definida,
# as URLs de convite são derivadas dos cabeçalhos `Host` /
# `X-Forwarded-Host` da requisição recebida. Em um deploy típico
# atrás de proxy, o proxy define esses cabeçalhos com o seu hostname
# canônico e eles são confiáveis. Em um deployment *sem proxy*,
# exposto diretamente à internet pública, um atacante poderia fazer
# um POST direto à API com um `Host: phishing.example` falsificado e
# receber uma URL de convite apontando para o site dele.
#
# Quando esta variável está definida, hostnames que não estão na
# lista são rejeitados (a requisição cai no fallback wacrm.tech com
# um console.warn). Quando não está definida, o comportamento
# permanece igual ao de versões anteriores — o host derivado da
# requisição é confiável.
#
# A maioria dos operadores não precisa disso: definir
# NEXT_PUBLIC_SITE_URL com sua URL canônica já fixa os links de
# convite nela. Isto é para operadores que querem cinto e suspensório
# ou que rodam setups multi-tenant onde uma única instância do app
# serve vários hostnames.
#
# Exemplo:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Meta App ID (Meta for Developers → App Settings → Basic).
# Obrigatório para criar/editar templates de mensagem com um cabeçalho
# do tipo IMAGE: a Meta só aceita um handle de mídia via
# Resumable-Upload (não uma URL simples) como amostra do cabeçalho, e
# esse upload é vinculado ao app. Sem ele, o envio de template com
# cabeçalho de imagem retorna um erro claro; templates somente de
# texto/corpo não são afetados. Use em conjunto com META_APP_SECRET.
#
# É o App PADRÃO da instância. Um número conectado sob outro App da Meta
# informa o App ID dele na tela do canal, e esse valor tem prioridade.
# META_APP_ID=your-meta-app-id

# Quando "true", POST /api/whatsapp/templates/submit pula a chamada à
# Meta e armazena o registro com um meta_template_id sintético
# `dry-run-<uuid>`. Defina isto no CI e no desenvolvimento local para
# poder testar toda a interface de templates sem uma WABA real. Deixe
# sem definir (ou "false") em produção.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# Assistente de respostas com IA (opcional)
# ------------------------------------------------------------------
# O assistente de IA é bring-your-own-key: cada conta cola sua própria
# chave OpenAI ou Anthropic em Settings → AI Assistant. A chave é
# armazenada criptografada com AES-256-GCM usando ENCRYPTION_KEY
# (acima) — NÃO existe uma variável de ambiente global de chave de
# provedor, e nada aqui é obrigatório para o recurso funcionar. As
# duas variáveis abaixo apenas ajustam o comportamento.
#
# A base de conhecimento de IA (migration 030) usa busca de texto
# completo do Postgres por padrão. A busca semântica opcional precisa
# da extensão `pgvector` — a migration 030 executa
# `CREATE EXTENSION IF NOT EXISTS vector` (o Supabase já a tem
# disponível) — além de uma chave de embeddings por conta, configurada
# em Settings → AI Assistant. Ainda assim, nenhuma variável de
# ambiente é necessária.

# Timeout por chamada para requisições ao provedor, em milissegundos.
# Padrão 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# Quantas mensagens de texto recentes de uma conversa enviar ao modelo
# como contexto (rascunho + resposta automática). Padrão 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# WhatsApp via QRCode — Evolution Go (opcional) — PRD 047
# ------------------------------------------------------------------
# URL base da Evolution Go rodando na sua VPS (sem barra no final).
# Sem esta variável, a aba "WhatsApp QRCode" aparece desabilitada com
# instruções — o restante do CRM não é afetado.
# EVOLUTION_API_URL=https://evo.seudominio.com.br

# Chave global da Evolution (GLOBAL_API_KEY do .env da VPS). Usada só
# para criar, listar e excluir instâncias. NUNCA prefixar com
# NEXT_PUBLIC_ — ela dá controle total sobre todas as instâncias.
# EVOLUTION_GLOBAL_API_KEY=

# Teto padrão de instâncias por conta. Pode ser sobrescrito por conta em
# accounts.evolution_instance_limit (NULL = usa este valor), ou pela
# quota de plano channels_whatsapp_qr quando quotas estão ligadas
# (SPEC 059) — o menor teto entre os dois vale.
# EVOLUTION_MAX_INSTANCES_PER_ACCOUNT=3

# Teto global do deployment inteiro — protege a VPS. É este, e não o
# limite por conta, que impede 10 contas × 3 instâncias derrubarem o
# servidor.
# EVOLUTION_MAX_INSTANCES_TOTAL=20

# Prefixo dos nomes de instância criados na VPS (auditoria e para evitar
# colisão entre deployments que compartilhem a mesma Evolution).
# EVOLUTION_INSTANCE_PREFIX=zapcrm

# Origem pública para montar a URL de webhook registrada na Evolution.
# Só necessária se diferir de NEXT_PUBLIC_SITE_URL (ex.: túnel em dev).
# EVOLUTION_WEBHOOK_PUBLIC_URL=

# Timeout por chamada à Evolution, em ms. Padrão 15000. Vale para
# /send/text e as chamadas de gerência de instância (rápidas — se a
# Evolution não responder nesse prazo, está mesmo fora do ar).
# EVOLUTION_REQUEST_TIMEOUT_MS=15000

# Timeout específico para /send/media, em ms. Padrão 60000.
#
# Por quê é separado do timeout acima: ao mandar mídia, a Evolution
# BAIXA o arquivo da nossa URL assinada e SOBE pro WhatsApp de forma
# síncrona, dentro da mesma requisição — ao contrário de /send/text
# (praticamente instantâneo). Um vídeo de alguns MB pode facilmente
# estourar os 15s do timeout genérico, abortando o envio do lado do
# CRM mesmo que a Evolution tivesse terminado um instante depois
# (sintoma visto em produção: "Evolution request failed: This
# operation was aborted" ao mandar vídeo pelo WhatsApp QRCode).
# Aumente se sua VPS tiver upload lento ou você mandar arquivos
# grandes com frequência.
# EVOLUTION_MEDIA_REQUEST_TIMEOUT_MS=60000

# Diagnóstico do formato do webhook — SÓ EM DESENVOLVIMENTO.
#
# Quando "true", loga a FORMA de cada payload recebido da Evolution e de
# cada resposta de /send/*: nomes de campo, tipos, valores longos
# truncados com o tamanho, e credenciais (`instanceToken`, `mediaKey`)
# redigidas. É a ferramenta para quando algo chega mas não funciona —
# áudio que não toca, eco que não aparece, recibo que não avança —, já
# que a nomenclatura do servidor mistura três convenções de caixa.
#
# Deixe DESLIGADA em produção: o log fica volumoso e roda antes da
# verificação do webhook, então uma requisição não autenticada também
# aparece nele.
# EVOLUTION_DEBUG=true

# ---- Teto de ENVIO FRIO (antispam) — PRD 047 §10.3 ----------------
#
# Só contam mensagens para quem NÃO está conversando com você. Responder
# alguém dentro de uma conversa viva tem risco zero e não consome cota.
# É o envio a contato em silêncio que caracteriza spam e derruba número.
#
# Os três tetos existem juntos de propósito: um limite só diário
# permitiria mandar tudo em cinco minutos — que é exatamente a rajada
# que o antispam do WhatsApp detecta.
#
# Estes valores são MOSTRADOS ao cliente na interface (construtor de
# automações e aba WhatsApp QRCode). Quem os define é você, o dono do
# sistema; o cliente só os consulta.
#
# Valor inválido cai no padrão — nunca vira "sem limite". Zerar perDay
# ou perHour DESLIGA o envio frio por instância não-oficial.

# Silêncio, em horas, a partir do qual um envio conta como frio.
# Padrão 24 (mesmo horizonte da janela da Meta, que o operador já
# conhece). Não aceita 0 — tudo viraria envio frio.
# EVOLUTION_COLD_SEND_SILENCE_HOURS=24

# Teto por instância nas últimas 24h CORRIDAS (não no dia do
# calendário: virada de meia-noite deixaria mandar 2× o limite).
# Padrão 60.
# EVOLUTION_COLD_SEND_PER_DAY=60

# Teto por instância na última hora corrida — é este que impede a
# rajada. Padrão 12.
# EVOLUTION_COLD_SEND_PER_HOUR=12

# Intervalo mínimo entre dois envios frios da mesma instância, em
# segundos. Padrão 45.
# EVOLUTION_COLD_SEND_MIN_INTERVAL_SECONDS=45

# Dias até a cota diária chegar ao teto acima. Instância nova mandando
# volume máximo no primeiro dia é o retrato do número descartável.
# A cota cresce linearmente; 0 desliga o aquecimento. Padrão 14.
# EVOLUTION_COLD_SEND_WARMUP_DAYS=14

# ------------------------------------------------------------------
# Enriquecimento e captação — instância QRCode (opcional) — SPEC 069
# ------------------------------------------------------------------
# NENHUMA variável abaixo é obrigatória: sem elas, o padrão de código
# (nível 3 da cascata instância > conta > .env > código) sempre
# responde, e os valores comentados SÃO os padrões — descomentar sem
# mudar o número não altera nada. Valor ausente, não inteiro ou
# negativo cai um nível — nunca vira "sem limite". `0` BLOQUEIA aquele
# eixo (exceto SILENCE_HOURS, onde 0 cai no padrão — silêncio zero
# tornaria todo envio "frio").

# Checagem de número (cota PRÓPRIA, separada do envio frio — D-1: uma
# checagem não pode apagar do dia um envio real que o cliente pagou).
# EVOLUTION_CHECK_PER_HOUR=60
# EVOLUTION_CHECK_PER_DAY=300
# EVOLUTION_CHECK_MIN_INTERVAL_SECONDS=5
# EVOLUTION_CHECK_BATCH_SIZE=25          # por execução do cron de 5 min
# EVOLUTION_CHECK_MAX_ATTEMPTS=3         # tentativas antes de virar failed
# EVOLUTION_CHECK_QUEUE_TTL_HOURS=168    # 7 dias — item mais velho expira

# `/user/info` e `/user/avatar` medidos contra o servidor real
# ficando pendurados por ~75s antes de o PRÓPRIO servidor Evolution
# desistir (achado da F3 — provavelmente autoconsulta, não confirmado
# contra terceiro). Nem o padrão de conectividade (15s, cedo demais)
# nem os 75s medidos (trava o lote inteiro atrás de um contato ruim)
# servem — este é o meio-termo, uma APOSTA registrada como tal.
# EVOLUTION_INFO_AVATAR_TIMEOUT_MS=20000

# Captação de contatos da agenda (R5) — a janela roda de madrugada, no
# fuso abaixo, não no fuso do banco (Supabase é UTC).
# EVOLUTION_HARVEST_PER_RUN=50
# EVOLUTION_HARVEST_MAX_PER_INSTANCE=500      # teto do campo do R1(c)
# EVOLUTION_HARVEST_WINDOW_START_HOUR=0
# EVOLUTION_HARVEST_WINDOW_END_HOUR=6         # EXCLUSIVO — última execução 05h
# EVOLUTION_HARVEST_TIMEZONE=America/Sao_Paulo

# Avatar trazido pela checagem/captação (bucket privado contact-avatars).
# EVOLUTION_AVATAR_TTL_DAYS=30
# EVOLUTION_AVATAR_MAX_BYTES=1048576     # 1 MB (o bucket aceita até 2 MB)

# Tetos DUROS do deployment (D-7) — clampam o override por CONTA e por
# INSTÂNCIA (nunca este .env: aqui é a palavra do próprio operador).
# Um valor acima do teto no .env gera console.warn UMA vez, porque
# significa teto mal configurado — nenhum override poderá alcançá-lo.
# EVOLUTION_COLD_SEND_PER_HOUR_MAX=40
# EVOLUTION_COLD_SEND_PER_DAY_MAX=250
# EVOLUTION_COLD_SEND_MIN_INTERVAL_SECONDS_MIN=10   # PISO — menor é mais perigoso
# EVOLUTION_COLD_SEND_WARMUP_DAYS_MIN=0             # PISO
# EVOLUTION_CHECK_PER_HOUR_MAX=200
# EVOLUTION_CHECK_PER_DAY_MAX=2000
# EVOLUTION_CHECK_MIN_INTERVAL_SECONDS_MIN=1        # PISO
# EVOLUTION_CHECK_BATCH_SIZE_MAX=100
# EVOLUTION_HARVEST_PER_RUN_MAX=200
# EVOLUTION_HARVEST_MAX_PER_INSTANCE_MAX=2000

# ------------------------------------------------------------------
# Console do proprietário da plataforma (opcional) — SPEC 062
# ------------------------------------------------------------------
# Duas portas DIFERENTES para as mesmas operações de operador (trocar
# plano de uma conta, bloquear conta/usuário, editar catálogo,
# resolver solicitação) — nenhuma delas obrigatória para o resto do
# app funcionar:
#
#   PLATFORM_OWNER_EMAILS — o console web `/admin`, com login normal
#     (a mesma tela de /login, mesmo Supabase Auth). Lista de e-mails
#     separados por vírgula; comparação normalizada (trim+lowercase) e
#     em tempo constante. SEM esta variável, `/admin` e toda rota
#     `/api/platform/**` respondem 404 para QUALQUER requisição —
#     mesmo do e-mail certo — de propósito (um estranho batendo na
#     rota não pode diferenciar "não configurado" de "acesso negado").
#     Exige e-mail confirmado (email_confirmed_at) na sessão.
# PLATFORM_OWNER_EMAILS=bruno@zapcrmbr.com

#   PLATFORM_ADMIN_SECRET — a porta de automação/scripts/n8n,
#     `/api/admin/**`, autenticada por header `x-admin-secret` (não
#     sessão). Mesmo formato do AUTOMATION_CRON_SECRET acima: sem esta
#     variável no servidor, as rotas respondem 503. Gere com:
#       openssl rand -hex 32
#     Trate como credencial de produção — qualquer um que tenha este
#     valor age como operador de TODAS as contas do deployment.
# PLATFORM_ADMIN_SECRET=generate-a-long-random-string

# ------------------------------------------------------------------
# Retenção e limpeza de mensagens (opcional) — SPEC 060
# ------------------------------------------------------------------
# Desligada por padrão. Sem MESSAGE_RETENTION_ENABLED, o CRM se
# comporta exatamente como antes: histórico completo, para sempre, em
# toda conta — ligar é decisão explícita do operador, nunca um
# comportamento que "vem ligado" num git pull. Quando ligada, uma
# varredura periódica (dentro do mesmo agendador cron configurado
# acima) pode remover mensagens antigas de `messages`, por conta e por
# tipo de canal — nunca a conversa em si, e nunca uma mensagem
# marcada como favorita. Desde a SPEC 062, os números por conta e o
# padrão global só são editáveis pelo Proprietário em `/admin/retention`
# — o dono da conta não vê mais essa configuração.

# Interruptor. Ausente = nada é apagado, em nenhuma conta, mesmo com
# tudo configurado no console.
# MESSAGE_RETENTION_ENABLED=true

# Padrões por tipo de canal, usados quando nem a conta nem o console
# (`/admin/retention`) definiram um valor próprio naquela dimensão.
# Ausente = sem limite ali. `0` também significa sem limite (nunca
# "apagar tudo") — mesma regra em toda a cadeia de precedência.
# MESSAGE_RETENTION_WHATSAPP_QR_MAX_MESSAGES=5000
# MESSAGE_RETENTION_WHATSAPP_QR_DAYS=30
# MESSAGE_RETENTION_WHATSAPP_QR_MAX_FAVORITES=200

# MESSAGE_RETENTION_WHATSAPP_CLOUD_MAX_MESSAGES=50000
# MESSAGE_RETENTION_WHATSAPP_CLOUD_DAYS=365
# MESSAGE_RETENTION_WHATSAPP_CLOUD_MAX_FAVORITES=2000

# Trilhos de segurança e ritmo — não são dimensões de limite, então
# valor ausente/inválido cai no padrão documentado, nunca em "sem
# limite".
# Piso de idade: nada mais novo que isto é apagado, não importa a
# política configurada. Protege reentrega do provedor, fluxo esperando
# resposta, atribuição de resposta a campanha e contexto de IA.
# MESSAGE_RETENTION_MIN_AGE_HOURS=72

# Intervalo mínimo entre varreduras, dentro do ciclo de
# /api/automations/cron (que é pingado a cada poucos minutos, mas só
# executa a varredura quando este intervalo venceu).
# MESSAGE_RETENTION_INTERVAL_HOURS=6

# Teto de linhas afetadas por fase, por conta × canal, em cada
# execução — protege contra uma varredura monstro travando o cron.
# MESSAGE_RETENTION_BATCH_LIMIT=5000

# ------------------------------------------------------------------
# Retenção do registro de atividade da conta (opcional) — SPEC 075
# ------------------------------------------------------------------
# A página /activity lê a tabela account_activity_log (quem fez o quê e
# quando). Esta variável apaga entradas antigas dessa tabela. É uma regra
# PRÓPRIA, separada da retenção de mensagens acima: corta só por idade e
# vale GLOBALMENTE (não por conta nem por canal), porque atividade não é
# conversa.
#
# Três estados possíveis:
#   ausente ou vazia → DESLIGADA. Nenhuma varredura apaga nada (padrão).
#   0                → LIGADA, mas sem apagar nada ("nunca apagar").
#                      Diferente de desligada: a regra fica ativa e a
#                      varredura informa isso no resultado.
#   N (inteiro > 0)  → LIGADA; apaga entradas com mais de N dias.
#
# Valor inválido (texto, negativo, fração) vira DESLIGADA, com aviso no log.
# Esta varredura roda em TODO ciclo do cron (/api/automations/cron e
# /api/messages/retention/cron) e NÃO depende de MESSAGE_RETENTION_ENABLED
# nem do intervalo MESSAGE_RETENTION_INTERVAL_HOURS. O valor abaixo é só
# um exemplo (365 dias):
# ACTIVITY_LOG_RETENTION_DAYS=365

# ------------------------------------------------------------------
# Notificações do sistema — SMTP + webhook (opcional) — SPEC 063
# ------------------------------------------------------------------
# Sem nenhuma variável a mais, o console (/admin) continua funcionando
# normalmente — as trocas de plano, bloqueios, contas novas e
# vencimentos só deixam de avisar o mantenedor por e-mail/webhook.
# Nenhum recurso do CLIENTE depende disto; um canal sem configuração é
# um no-op silencioso, nunca um erro que derruba a ação que originou o
# aviso. NUNCA use este SMTP para autenticação (confirmação de
# cadastro, recuperação de senha) — isso é do Supabase Auth, à parte.

# Sem SMTP_HOST ou SYSTEM_NOTIFICATION_EMAIL, o canal de e-mail é
# desligado por completo (host sem destinatário não é configuração
# parcial, é nenhuma). SMTP_PORT ausente ou inválida também desliga o
# canal, com aviso no log.
#
# SMTP_HOST: servidor SMTP do seu provedor (ex.: smtp.gmail.com).
# SMTP_PORT: 587 para STARTTLS (use SMTP_SECURE=false) ou 465 para SSL
#   implícito (use SMTP_SECURE=true).
# SMTP_SECURE: só "true" ou "1" ligam o SSL implícito; qualquer outro
#   valor (ou ausência) = false.
# SMTP_USER: usuário de autenticação (geralmente o próprio e-mail). Sem
#   ele, o envio é anônimo — a maioria dos provedores recusa.
# SMTP_PASSWORD: senha do usuário. No Gmail é uma SENHA DE APP de 16
#   caracteres (exige verificação em duas etapas), não a senha da conta.
#   É segredo: nunca prefixar com NEXT_PUBLIC_.
# SMTP_FROM: remetente exibido nos avisos, no formato
#   "Nome <endereco@dominio>". Precisa ser um endereço que o provedor
#   aceite enviar.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=avisos@zapcrmbr.com
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_FROM="ZAP CRM BR <avisos@zapcrmbr.com>"

# Destinatário dos avisos — você, o mantenedor, nunca o cliente.
# SYSTEM_NOTIFICATION_EMAIL=bruno@zapcrmbr.com

# Webhook. PLAN_REQUEST_WEBHOOK_URL é a variável legada (usada só para
# solicitações de troca de plano, ainda suportada); SYSTEM_EVENT_WEBHOOK_URL
# é o alias novo que recebe TODOS os eventos do sistema — se as duas
# existirem, a nova vence. Passa pela mesma guarda de SSRF dos webhooks
# de saída por conta.
# PLAN_REQUEST_WEBHOOK_URL=https://n8n.exemplo.com/webhook/zapcrm
# SYSTEM_EVENT_WEBHOOK_URL=

# Opcional — quando definida, assina o corpo entregue com HMAC-SHA256
# no header X-ZapCRM-Signature (não quebra o workflow que já existe
# sem verificação).
# SYSTEM_EVENT_WEBHOOK_SECRET=
